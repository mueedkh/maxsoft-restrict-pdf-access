<?xml version="1.0"?>
<ruleset name="MaXsoft Restrict PDF Access">
	<description>Coding standards for the MaXsoft Restrict PDF Access plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!-- The settings array is stored as one option, so a shorter key set
		     inside it is fine; the option name itself carries the prefix. -->
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="maxsoft-restrict-pdf-access"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="maxsoft_rpdf"/>
				<element value="MAXSOFT_RPDF"/>
			</property>
		</properties>
	</rule>
</ruleset>
